# Konfiguration der Filial-App (Beispiel, nur Platzhalter).
# Im Original liest Docker Compose diese Werte aus einer .env auf dem Server. Echte Werte gehören nie ins Repository.

# Adresse der App und Kontakt für das HTTPS-Zertifikat
DOMAIN=<deine-domain>
ACME_EMAIL=<kontakt-fuer-zertifikate>

# Datenbank
POSTGRES_PASSWORD=<zufaelliges-langes-passwort>

# Pflicht in Produktion
ZEITZONE=Europe/Berlin
# ja im Echtbetrieb, nein nur auf einem Testserver mit erfundenen Daten
ZWEI_FAKTOR_PFLICHT=ja
# 32 Byte als Base64, erzeugen mit: openssl rand -base64 32
GEHEIMNIS_SCHLUESSEL=<32-byte-base64>

# E-Mail (Einladungen, Passwort vergessen, Benachrichtigungen). Leer: Es geht keine E-Mail raus.
SMTP_URL=<smtp-zugang>
MAIL_ABSENDER=<absenderadresse>

# Web Push. Leer: kein Push, Benachrichtigungen nur per E-Mail.
VAPID_OEFFENTLICH=<vapid-public-key>
VAPID_GEHEIM=<vapid-private-key>
VAPID_KONTAKT=<kontakt-fuer-push-dienste>

# Backup (optional, läuft nur auf Zuruf)
BACKUP_AGE_EMPFAENGER=<age-public-key>
BACKUP_ZIEL=<sftp-ziel>
BACKUP_ZIEL_PORT=<port>
BACKUP_MELDE_URL=<wachhund-url>
